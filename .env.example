BOT_TOKEN=replace_with_your_telegram_bot_token
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=agent_member_bot
# Comma-separated owner Telegram IDs. Owners can add/remove database-backed admins.
OWNER_IDS=123456789
# Legacy bootstrap variable. If OWNER_IDS is empty, these IDs become owners.
ADMIN_IDS=123456789
LOG_LEVEL=INFO